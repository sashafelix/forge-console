{
  "name": "agent-pipeline-ui",
  "version": "0.7.3",
  "private": true,
  "description": "Cross-platform, task-first quality workbench for repository agents and pipelines",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','release']) fs.rmSync(p,{recursive:true,force:true})\"",
    "dev": "concurrently -k -n renderer,electron-ts,electron \"npm:dev:renderer\" \"npm:dev:electron:compile\" \"npm:dev:electron:launch\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron:compile": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:launch": "wait-on http-get://127.0.0.1:5173 file:dist/electron/main/index.js file:dist/electron/main/preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "build": "npm run clean && npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.frankhaughton.agentpipelineui",
    "productName": "Agent Pipeline UI",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packs",
        "to": "packs"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "category": "Development",
      "target": ["AppImage", "deb"]
    }
  }
}
